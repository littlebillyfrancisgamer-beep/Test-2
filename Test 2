-- Spectate Functions
local function stopSpectating()
    spectatingPlayer = nil
    if currentSpectateConnection then
        currentSpectateConnection:Disconnect()
        currentSpectateConnection = nil
    end
    
    Camera.CameraType = Enum.CameraType.Custom
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        Camera.CameraSubject = LocalPlayer.Character.Humanoid
    end
    
    StopSpectateOverlayBtn.Visible = false
    SendNotification("Spectator Mode", "Stopped spectating.", 3)
end

local function startSpectating(target)
    if not target or target == LocalPlayer then 
        SendNotification("Spectator", "Cannot spectate yourself.", 2)
        return 
    end
    
    spectatingPlayer = target
    StopSpectateOverlayBtn.Visible = true
    SendNotification("Spectator Mode", "Now spectating " .. target.DisplayName, 3)

    if currentSpectateConnection then currentSpectateConnection:Disconnect() end
    currentSpectateConnection = RunService.RenderStepped:Connect(function()
        if spectatingPlayer and spectatingPlayer.Character then
            local humanoid = spectatingPlayer.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                Camera.CameraSubject = humanoid
            end
        else
            stopSpectating()
        end
    end)
end

StopSpectateOverlayBtn.MouseButton1Click:Connect(stopSpectating)

UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if ActionModal.Visible then
            local mousePos = UserInputService:GetMouseLocation()
            local absPos = ActionModal.AbsolutePosition
            local absSize = ActionModal.AbsoluteSize
            if mousePos.X < absPos.X or mousePos.X > absPos.X + absSize.X or mousePos.Y < absPos.Y or mousePos.Y > absPos.Y + absSize.Y then
                ActionModal.Visible = false
            end
        end
    end
end)

