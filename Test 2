-- Continuous loop for tracking stats & real-time player count
RunService.RenderStepped:Connect(function()
    local activeCount = 0
    for player, elements in pairs(playerUIElements) do
        activeCount = activeCount + 1
        local character = player.Character
        local localChar = LocalPlayer.Character
        
        if character and character:FindFirstChild("Humanoid") then
            local humanoid = character.Humanoid
            local hrp = character:FindFirstChild("HumanoidRootPart")
            
            local distStr = "Distance: N/A"
            if localChar and localChar:FindFirstChild("HumanoidRootPart") and hrp then
                local distance = math.floor((localChar.HumanoidRootPart.Position - hrp.Position).Magnitude)
                distStr = distance .. " studs"
            end

            local tag = (player == LocalPlayer) and " [You]" or ""
            elements.Info.Text = string.format("%s%s | %s", player.DisplayName, tag, distStr)

            local health = math.clamp(humanoid.Health, 0, humanoid.MaxHealth)
            local maxHealth = humanoid.MaxHealth > 0 and humanoid.MaxHealth or 100
            local healthPercent = health / maxHealth
            
            elements.Fill.Size = UDim2.new(healthPercent, 0, 1, 0)
            
            if healthPercent > 0.5 then
                elements.Fill.BackgroundColor3 = Color3.fromRGB(80, 140, 220)
            elseif healthPercent > 0.25 then
                elements.Fill.BackgroundColor3 = Color3.fromRGB(220, 160, 60)
            else
                elements.Fill.BackgroundColor3 = Color3.fromRGB(200, 50, 60)
            end
        else
            local tag = (player == LocalPlayer) and " [You]" or ""
            elements.Info.Text = string.format("%s%s | Dead/Respawning", player.DisplayName, tag)
            elements.Fill.Size = UDim2.new(0, 0, 1, 0)
        end
    end
    
    ListTitle.Text = string.format("  👥 Lobby Players [%d/%d]", #Players:GetPlayers(), Players.MaxPlayers)
    PlayerScrollContainer.CanvasSize = UDim2.new(0, 0, 0, activeCount * 50)
end)

