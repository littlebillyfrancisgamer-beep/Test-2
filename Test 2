local function getColorValue(selection)
    if selection == "Rainbow" then
        local tickTime = tick() * 5
        return Color3.fromHSV(tickTime % 1, 1, 1)
    elseif selection == "Randomizer" then
        return Color3.fromRGB(math.random(0, 255), math.random(0, 255), math.random(0, 255))
    end
    return ColorOptions[selection] or Color3.fromRGB(255, 50, 50)
end

