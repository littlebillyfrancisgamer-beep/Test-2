local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = false
FOVCircle.Transparency = 0.7
FOVCircle.Thickness = 1
FOVCircle.Filled = false

local espBoxes = {}

local function removeESP(player)
    if espBoxes[player] then
        espBoxes[player]:Remove()
        espBoxes[player] = nil
    end
end

local function isVisible(targetPart)
    if not _G.Settings.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    local ignoreList = {LocalPlayer.Character}
    if targetPart.Parent then table.insert(ignoreList, targetPart.Parent) end
    raycastParams.FilterDescendantsInstances = ignoreList
    raycastParams.IgnoreWater = true
    
    local result = workspace:Raycast(origin, direction, raycastParams)
    return result == nil
end

local function getClosestTarget()
    local targetPart = nil
    local shortestDist = _G.Settings.FOV
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local isTeamMate = false
            if _G.Settings.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                isTeamMate = true
            end

            if not isTeamMate then
                local character = player.Character
                if character and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
                    local chosenPart = nil
                    if _G.Settings.AimPart == "Head" then
                        chosenPart = character:FindFirstChild("Head")
                    elseif _G.Settings.AimPart == "HumanoidRootPart" then
                        chosenPart = character:FindFirstChild("HumanoidRootPart")
                    elseif _G.Settings.AimPart == "Random" then
                        local parts = {character:FindFirstChild("Head"), character:FindFirstChild("HumanoidRootPart")}
                        chosenPart = parts[math.random(1, #parts)]
                    end

                    if chosenPart and isVisible(chosenPart) then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(chosenPart.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                targetPart = chosenPart
                            end
                        end
                    end
                end
            end
        end
    end
    return targetPart
end

RunService.RenderStepped:Connect(function()
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    if _G.Settings.AimbotEnabled then
        FOVCircle.Visible = true
        FOVCircle.Radius = _G.Settings.FOV
        FOVCircle.Position = screenCenter
        FOVCircle.Color = getColorValue(_G.Settings.FOVColor)
        FOVCircle.Thickness = _G.Settings.FOVThickness
        FOVCircle.Filled = _G.Settings.FOVFilled
        FOVCircle.Transparency = _G.Settings.FOVFilled and 0.25 or 0.7
        
        local target = getClosestTarget()
        if target then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, target.Position), 1 / _G.Settings.Smoothness)
        end
    else
        FOVCircle.Visible = false
    end

    -- Dynamic UI Theme color update loop for Rainbow effect support
    if _G.Settings.UIThemeColor == "Rainbow" then
        local currentRainbowColor = getColorValue("Rainbow")
        for _, guiObj in ipairs(ScreenGui:GetDescendants()) do
            if guiObj:IsA("UIStroke") and guiObj.Name == "DynamicStroke" then
                guiObj.Color = currentRainbowColor
            end
        end
    end

    local currentESPColor = getColorValue(_G.Settings.ESPColor)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local box = espBoxes[player]
            
            if not box and _G.Settings.ESPEnabled then
                box = Drawing.new("Square")
                box.Visible = false
                box.Thickness = 1
                box.Filled = false
                espBoxes[player] = box
            end

            if box then
                box.Color = currentESPColor
                if _G.Settings.ESPEnabled and character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
                    local skip = false
                    if _G.Settings.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                        skip = true
                    end

                    if not skip then
                        local rootPart = character.HumanoidRootPart
                        local pos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                        if onScreen then
                            local size = math.clamp(2500 / pos.Z, 15, 300)
                            box.Size = Vector2.new(size * 0.6, size)
                            box.Position = Vector2.new(pos.X - box.Size.X / 2, pos.Y - box.Size.Y / 2)
                            box.Visible = true
                        else
                            box.Visible = false
                        end
                    else
                        box.Visible = false
                    end
                else
                    box.Visible = false
                end
            end
        end
    end
end)

